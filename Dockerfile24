ARG NODE_VERSION=24
ARG BASE_RUNTIME_DISTRO=slim

FROM node:${NODE_VERSION}-${BASE_RUNTIME_DISTRO}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TARGETARCH
ARG PNPM_VERSION=latest
ARG IONIC_VERSION=latest

ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm/bin:/pnpm:$PATH"

WORKDIR /app

RUN DEBIAN_FRONTEND=noninteractive apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade && DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends --no-install-suggests ca-certificates tzdata s3fs awscli wget nano curl git && apt-get clean && DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*
RUN --mount=type=cache,id=npm-${TARGETARCH},target=/root/.npm,sharing=locked groupadd -g 10001 appgroup && useradd -u 10001 -g appgroup -m -d /home/appuser -s /usr/sbin/nologin appuser && mkdir -p "$PNPM_HOME" /home/appuser/.config/pnpm && printf "minimum-release-age=1440\n" > /home/appuser/.config/pnpm/rc && npm install -g --no-fund --no-audit "pnpm@${PNPM_VERSION}" && pnpm add --global "@ionic/cli@${IONIC_VERSION}" && pnpm store prune && rm -rf /root/.cache /root/.local/share/pnpm /tmp/* && mv /usr/local/bin/npm /usr/local/bin/.npm-real && chown -R 10001:10001 /app "$PNPM_HOME" /home/appuser

COPY --chmod=0755 npm-shield.sh /usr/local/bin/npm

ARG BUILD_DATE
LABEL org.opencontainers.image.authors="Jesus Palencia <sinfallas@gmail.com> (Creado en Tecno Consultores)" \
      org.opencontainers.image.description="Base Node.js 24 image with pnpm and Ionic CLI" \
      org.opencontainers.image.source="https://hub.docker.com/r/sinfallas/base-node-ionic" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.created="${BUILD_DATE}"

USER 10001:10001
CMD ["/bin/bash"]
