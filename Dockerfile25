FROM node:25-slim
ARG BUILD_DATE
LABEL org.opencontainers.image.authors="sinfallas@gmail.com"
LABEL org.opencontainers.image.created=$BUILD_DATE

ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:/pnpm/bin:$PATH"

v
RUN rm -rf /usr/local/bin/npm && ln -s /usr/local/bin/pnpm /usr/local/bin/npm

WORKDIR /app
RUN apt update -qq && apt -y dist-upgrade && apt -y install --no-install-recommends --no-install-suggests tzdata s3fs awscli wget nano curl git && apt-get clean && apt -y autoremove && rm -rf /var/lib/{apt,dpkg,cache,log}
RUN pnpm add --global @ionic/cli

CMD ["/bin/bash"]
